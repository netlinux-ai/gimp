diff --git a/icons/Default/scalable/gimp-tool-screenshot-symbolic.svg b/icons/Default/scalable/gimp-tool-screenshot-symbolic.svg
new file mode 100644
index 0000000..acc7f7b
--- /dev/null
+++ b/icons/Default/scalable/gimp-tool-screenshot-symbolic.svg
@@ -0,0 +1,43 @@
+<?xml version="1.0" encoding="UTF-8" standalone="no"?>
+<svg
+   xmlns:dc="http://purl.org/dc/elements/1.1/"
+   xmlns:cc="http://creativecommons.org/ns#"
+   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
+   xmlns:svg="http://www.w3.org/2000/svg"
+   xmlns="http://www.w3.org/2000/svg"
+   width="16"
+   height="16"
+   viewBox="0 0 16 16"
+   id="svg1"
+   version="1.1">
+  <defs id="defs1" />
+  <metadata id="metadata1">
+    <rdf:RDF>
+      <cc:Work rdf:about="">
+        <dc:format>image/svg+xml</dc:format>
+        <dc:type rdf:resource="http://purl.org/dc/dcmitype/StillImage" />
+        <dc:title>Screenshot Tool</dc:title>
+      </cc:Work>
+    </rdf:RDF>
+  </metadata>
+  <g id="gimp-tool-screenshot">
+    <!-- Viewfinder bump -->
+    <path d="M 5,3 L 6,1 L 10,1 L 11,3 Z"
+          style="fill:#bebebe" />
+    <!-- Camera body -->
+    <rect x="1" y="3" width="14" height="11" rx="1" ry="1"
+          style="fill:#bebebe" />
+    <!-- Lens outer ring (cut out) -->
+    <circle cx="8" cy="9" r="4"
+            style="fill:#000000" />
+    <!-- Lens ring (filled) -->
+    <circle cx="8" cy="9" r="3"
+            style="fill:#bebebe" />
+    <!-- Lens inner (cut out) -->
+    <circle cx="8" cy="9" r="2"
+            style="fill:#000000" />
+    <!-- Lens center dot -->
+    <circle cx="8" cy="9" r="0.8"
+            style="fill:#bebebe" />
+  </g>
+</svg>
