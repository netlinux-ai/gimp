+
+
+#include "gimptool.h"
+
+
+#define GIMP_TYPE_SCREENSHOT_TOOL            (gimp_screenshot_tool_get_type ())
+#define GIMP_SCREENSHOT_TOOL(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_SCREENSHOT_TOOL, GimpScreenshotTool))
+#define GIMP_SCREENSHOT_TOOL_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass), GIMP_TYPE_SCREENSHOT_TOOL, GimpScreenshotToolClass))
+#define GIMP_IS_SCREENSHOT_TOOL(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), GIMP_TYPE_SCREENSHOT_TOOL))
+#define GIMP_IS_SCREENSHOT_TOOL_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass), GIMP_TYPE_SCREENSHOT_TOOL))
+#define GIMP_SCREENSHOT_TOOL_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj), GIMP_TYPE_SCREENSHOT_TOOL, GimpScreenshotToolClass))
+
+
+typedef struct _GimpScreenshotTool      GimpScreenshotTool;
+typedef struct _GimpScreenshotToolClass GimpScreenshotToolClass;
+
+struct _GimpScreenshotTool
+{
+  GimpTool  parent_instance;
+};
+
+struct _GimpScreenshotToolClass
+{
+  GimpToolClass  parent_class;
+};
+
+
+void    gimp_screenshot_tool_register (GimpToolRegisterCallback  callback,
+                                       gpointer                  data);
+
+GType   gimp_screenshot_tool_get_type (void) G_GNUC_CONST;
+
+void    gimp_screenshot_tool_snap     (Gimp                     *gimp,
+                                       GimpToolInfo             *prev_tool_info);
+
+
+#endif  /*  __GIMP_SCREENSHOT_TOOL_H__  */
