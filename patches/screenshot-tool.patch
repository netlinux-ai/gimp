+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimp-gui.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+#include "core/gimpprogress.h"
+#include "core/gimptoolinfo.h"
+
+#include "pdb/gimppdb.h"
+#include "pdb/gimpprocedure.h"
+
+#include "display/gimpdisplay.h"
+
+#include "gimpscreenshottool.h"
+#include "gimptoolcontrol.h"
+
+#include "gimp-intl.h"
+
+
+typedef struct
+{
+  Gimp         *gimp;
+  GimpToolInfo *prev_tool_info;
+} ScreenshotIdleData;
+
+
+G_DEFINE_TYPE (GimpScreenshotTool, gimp_screenshot_tool, GIMP_TYPE_TOOL)
+
+#define parent_class gimp_screenshot_tool_parent_class
+
+
+void
+gimp_screenshot_tool_register (GimpToolRegisterCallback  callback,
+                                gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_SCREENSHOT_TOOL,
+                G_TYPE_NONE,
+                NULL,
+                0,
+                "gimp-screenshot-tool",
+                _("Screenshot"),
+                _("Screenshot Tool: Capture a screenshot"),
+                N_("Scr_eenshot"), NULL,
+                NULL, "gimp-tool-screenshot",
+                GIMP_ICON_TOOL_SCREENSHOT,
+                data);
+}
+
+static void
+gimp_screenshot_tool_class_init (GimpScreenshotToolClass *klass)
+{
+}
+
+static void
+gimp_screenshot_tool_init (GimpScreenshotTool *screenshot_tool)
+{
+  GimpTool *tool = GIMP_TOOL (screenshot_tool);
+
+  gimp_tool_control_set_handle_empty_image (tool->control, TRUE);
+  gimp_tool_control_set_snap_to            (tool->control, FALSE);
+}
+
+static gboolean
+gimp_screenshot_tool_idle_snap (gpointer user_data)
+{
+  ScreenshotIdleData *data        = user_data;
+  Gimp               *gimp        = data->gimp;
+  GError             *error       = NULL;
+  GimpValueArray     *return_vals;
+
+  return_vals =
+    gimp_pdb_execute_procedure_by_name (gimp->pdb,
+                                        gimp_get_user_context (gimp),
+                                        NULL, &error,
+                                        "plug-in-screenshot",
+                                        GIMP_TYPE_RUN_MODE, GIMP_RUN_NONINTERACTIVE,
+                                        G_TYPE_STRING,      "screen",
+                                        G_TYPE_INT,         0,
+                                        G_TYPE_INT,         0,
+                                        G_TYPE_INT,         0,
+                                        G_TYPE_INT,         0,
+                                        G_TYPE_BOOLEAN,     FALSE,
+                                        G_TYPE_STRING,      "monitor",
+                                        G_TYPE_NONE);
+
+  if (return_vals)
+    {
+      GimpPDBStatusType status;
+
+      status = g_value_get_enum (gimp_value_array_index (return_vals, 0));
+
+      if (status == GIMP_PDB_SUCCESS)
+        {
+          GimpImage *image;
+
+          image = g_value_get_object (gimp_value_array_index (return_vals, 1));
+
+          if (image)
+            gimp_create_display (gimp, image, gimp_unit_pixel (), 1.0, NULL);
+        }
+      else if (error)
+        {
+          gimp_message (gimp, NULL, GIMP_MESSAGE_ERROR,
+                        _("Screenshot failed: %s"), error->message);
+          g_error_free (error);
+        }
+
+      gimp_value_array_unref (return_vals);
+    }
+
+  /* Restore the previous tool */
+  if (data->prev_tool_info)
+    {
+      gimp_context_set_tool (gimp_get_user_context (gimp),
+                             data->prev_tool_info);
+      g_object_unref (data->prev_tool_info);
+    }
+
+  g_slice_free (ScreenshotIdleData, data);
+
+  return G_SOURCE_REMOVE;
+}
+
+/*  Called from tool_manager_tool_changed when this tool is selected.
+ *  Defers the actual screenshot to an idle callback to avoid
+ *  re-entrancy issues in the tool manager.
+ */
+void
+gimp_screenshot_tool_snap (Gimp            *gimp,
+                           GimpToolInfo    *prev_tool_info)
+{
+  ScreenshotIdleData *data;
+
+  data = g_slice_new (ScreenshotIdleData);
+  data->gimp           = gimp;
+  data->prev_tool_info = prev_tool_info ? g_object_ref (prev_tool_info) : NULL;
+
+  g_idle_add (gimp_screenshot_tool_idle_snap, data);
+}
